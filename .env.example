# Copy to .env and fill in. .env is gitignored — never commit real values.

# Dune API key — free at https://dune.com/settings/api
DUNE_API_KEY=

# The Graph API key — optional for public endpoints, needed for higher rate limits
# https://thegraph.com/studio/apikeys/
GRAPH_API_KEY=

# Public RPC endpoint (free tiers: Alchemy, Infura, publicnode)
WEB3_RPC_URL=

# BigQuery — path to service-account JSON key, or leave blank to use
# `gcloud auth application-default login` instead
GOOGLE_APPLICATION_CREDENTIALS=
